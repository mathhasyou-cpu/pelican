# Скопировать в .env и заполнить. Переменные окружения сильнее значений из файла.

# --- Postgres (корпус, разметка, очередь, отчёты) ---
POSTGRES_PASSWORD=pelican
# Для запуска вне Docker (сбор, перелив, скрипты). Внутри compose адрес задан сам.
DATABASE_URL=postgresql://pelican:pelican@127.0.0.1:5436/pelican

# --- Локальная модель: OpenAI-совместимый сервер (LM Studio) на хосте ---
# Вне Docker:
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Из контейнера к тому же серверу на хосте:
LLM_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-12b-qat
EMBEDDING_MODEL=google/embedding-gemma-300m

# --- Файлы ---
# Шарды векторов корпуса на хосте (монтируются в api только на чтение).
EMB_HOST_DIR=./data/emb-science
# Вне Docker: где лежат шарды и состояние приложения.
EMB_DIR=./data/emb-science
DATA_DIR=data

# --- Живые источники (необязательно) ---
# Без токена GitHub поиск работает с меньшим лимитом запросов.
GITHUB_TOKEN=
# EPO OPS (патенты): без обоих ключей патентный канал выключен.
EPO_OPS_KEY=
EPO_OPS_SECRET=
# Контакт в User-Agent для arXiv/OpenAlex.
CONTACT=
# Ключ OpenAlex — суточный бюджет запросов сбора ($1 в сутки бесплатно).
OPENALEX_API_KEY=

# --- Публичный стенд (профиль stand) ---
TS_AUTHKEY=
