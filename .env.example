# Скопировать в .env и заполнить. Переменные окружения сильнее значений из файла.
# Секреты здесь только именами (NFR-36): закомментированная строка — образец формы, не значение.

# --- Postgres (корпус, разметка, очередь, отчёты) ---
# Без значения compose берёт пароль разработки `pelican` — на стенде задать свой.
# POSTGRES_PASSWORD=
# Для запуска вне Docker (сбор, перелив, скрипты). Внутри compose адрес задан сам.
# DATABASE_URL=postgresql://pelican:<пароль>@127.0.0.1:5436/pelican

# --- Локальная модель: OpenAI-совместимый сервер (LM Studio) на хосте ---
# Вне Docker:
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Из контейнера к тому же серверу на хосте:
LLM_BASE_URL_DOCKER=http://host.docker.internal:1234/v1
# LM Studio ключ не проверяет; без строки берётся `lm-studio` (config.py).
# LLM_API_KEY=
LLM_MODEL=google/gemma-4-12b-qat
EMBEDDING_MODEL=google/embedding-gemma-300m
# Отдельная точка эмбеддингов (пусто — та же, что у генерации): когда генерация идёт в
# облачную модель без эмбеддингов, например sonar в замере docs/final-measure.md.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Файлы ---
# Шарды векторов корпуса на хосте (монтируются в api только на чтение).
EMB_HOST_DIR=./data/emb-science
# Вне Docker: где лежат шарды и состояние приложения.
EMB_DIR=./data/emb-science
# Сервер шардов (`pelican.shard_server`): пусто — api проходит шарды сам. Из контейнера —
# `SHARDS_URL_DOCKER` (по умолчанию http://host.docker.internal:8020).
SHARDS_URL=
SHARDS_URL_DOCKER=
SHARD_SERVER_PORT=8020
DATA_DIR=data

# --- Живые источники (необязательно) ---
# Без токена GitHub поиск работает с меньшим лимитом запросов.
GITHUB_TOKEN=
# EPO OPS (патенты): без обоих ключей патентный канал выключен.
EPO_OPS_KEY=
EPO_OPS_SECRET=
# Контакт в User-Agent для arXiv/OpenAlex.
CONTACT=
# Ключ OpenAlex — суточный бюджет запросов сбора ($1 в сутки бесплатно).
OPENALEX_API_KEY=
# Токен выгрузки корпуса из Quack (`pelican.load_corpus`, `scripts/measure_pg_footprint.py`).
QUACK_TOKEN=

# --- Бюджет запроса ---
# Потолок времени одного запроса, с (`weak/ask.BUDGET_S`, по умолчанию 1100).
# WEAK_BUDGET_S=1100

# --- Доработки к финалу: включать только после замера (docs/final-measure.md) ---
# WEAK_ONPOINT_COMPANIES=1   # компании только из заголовков про эту технологию
# WEAK_LAYERS=1              # уже тренд / слабый сигнал / зарождающееся — «наблюдать»
# WEAK_TECHNIQUE=1           # приём за направлением; без приёма — общая категория
# WEAK_EXTRA_SOURCES=1       # гранты NIH, препринты, ClinicalTrials.gov, каталог YC

# Отсечка истории стенда (ISO-время): старые отчёты не показываются в истории и не отдаются
# из кэша повтора; по прямой ссылке остаются (`jobs.since`). Пусто — без отсечки.
REPORTS_SINCE=
# WEAK_BURST=1               # направления из всплеска в корпусе: 1 — к направлениям модели, only — вместо
# WEAK_LISTED_IN_ASK=1       # модель списка заказчика первым ключом порядка ТОП

# --- Публичный стенд (профиль stand) ---
TS_AUTHKEY=

# --- Тонкая настройка: без строки — значение по умолчанию из config.py / docker-compose.yml ---
# LLM_PIPELINE_DEPTH=3
# LLM_TIMEOUT_S=180
# LLM_REASONING_EFFORT=none
# EMBEDDING_BATCH_SIZE=64
# ARXIV_CATEGORIES=          # через запятую; по умолчанию — список config.py
# OPENALEX_FILTERS=
# NEWS_LOCAL_ADDRESS=        # локальный адрес для Google News; пусто — через маршрут по умолчанию
# WEB_DIR=                   # собранный web/dist, если не рядом с пакетом
# API_PORT=8010
# POSTGRES_PORT=5436
# PELICAN_API=http://127.0.0.1:8010   # куда `npm run dev` проксирует /api
# TABPFN_TOKEN=              # только scripts/model_zoo.py: лицензия весов TabPFN
